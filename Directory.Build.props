<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <IsPackable>false</IsPackable>
    <Authors>Aleksandr Pavlov</Authors>
    <Copyright>Copyright (c) 2026 Aleksandr Pavlov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- Give each package verification run its own restore, compiler and pack inputs.
       Keep one repository Source Link root for both handwritten and generated sources. -->
  <PropertyGroup Condition="'$(ZkLinkPackageBuildRoot)' != ''">
    <BaseOutputPath>$(ZkLinkPackageBuildRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ZkLinkPackageBuildRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Instrumented project references use distinct binaries in both Debug and Release. -->
  <PropertyGroup Condition="'$(ZkLinkTestAccess)' == 'true'">
    <BaseOutputPath>bin/test-access/</BaseOutputPath>
    <IntermediateOutputPath>obj/test-access/$(Configuration)/</IntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <DefineConstants>$(DefineConstants);ZKLINK_TEST_ACCESS</DefineConstants>
  </PropertyGroup>
</Project>
